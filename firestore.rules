rules_version = '2';

// ============================================================
// DataShield — Firestore Security Rules
// Project: delete-and-recovery
// Last Updated: 2026-09-21
//
// HOW TO DEPLOY:
//   1. Go to: https://console.firebase.google.com/project/delete-and-recovery/firestore/rules
//   2. Paste the entire contents of this file
//   3. Click "Publish"
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth.token.get('role', '') in ['admin', 'security_admin'];
    }

    // ----------------------------------------------------------
    // USERS COLLECTION — users/{uid}
    // ----------------------------------------------------------
    match /users/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && isOwner(uid);
      allow list: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ----------------------------------------------------------
    // AUDIT LOGS — audit_logs/{logId}  (append-only, immutable)
    // ----------------------------------------------------------
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // ERASURE RECORDS — erasure_records/{recordId}
    // ----------------------------------------------------------
    match /erasure_records/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // Default: deny everything else
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
